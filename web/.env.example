# Base URL of the funding-atlas data API (FastAPI, see src/funding_atlas/api).
# No trailing slash. Read in the browser, so it must be reachable from the
# client — in production this is normally the same host behind Caddy.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Mock mode. Set to 1 to serve every endpoint from the in-browser fixture
# layer in src/lib/api/mock.ts instead of the API. Intended for development
# and review before the recorder is running. Any other value (or unset) means
# live data. While it is on, every page is stamped "MOCK DATA".
NEXT_PUBLIC_MOCK_API=0
