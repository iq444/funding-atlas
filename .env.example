# ---- Recorder ----
FA_ENV=dev
FA_DATA_DIR=./data
FA_CONFIG=./config/recorder.yaml
FA_LOG_LEVEL=INFO

# ---- Postgres (operational state + audit) ----
FA_PG_DSN=postgresql://atlas:atlas@localhost:5432/atlas

# ---- Cold storage (optional, Cloudflare R2 / S3-compatible) ----
# FA_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# FA_S3_BUCKET=funding-atlas
# FA_S3_KEY_ID=
# FA_S3_SECRET=

# ---- Hyperliquid ----
# Public market data needs NO credentials. Keys belong in the private engine repo,
# never here. Testnet first.
FA_HL_NETWORK=mainnet

# ---- Edge (Caddy), only needed on a host that serves the public site ----
# FA_DOMAIN=fundingatlas.online
# FA_API_DOMAIN=api.fundingatlas.online
# FA_ACME_EMAIL=you@example.com
